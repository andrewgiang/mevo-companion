<Window x:Class="MevoCompanion.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mevo Companion" Width="1180" Height="830" MinWidth="1000" MinHeight="720"
        FontFamily="Segoe UI" Background="{StaticResource Canvas}" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded" Closing="Window_Closing">
  <Window.Resources>
    <!-- Stepper entry: circle, title and state, clickable to jump between setup steps. -->
    <Style x:Key="StepButton" TargetType="Button" BasedOn="{StaticResource Ghost}">
      <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="6,6"/><Setter Property="FontWeight" Value="Normal"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <!-- ============ Sidebar ============ -->
    <Border Background="#102D27">
      <Grid Margin="14,24,14,18">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="8,0,0,28">
          <Border Background="#D4EBCF" CornerRadius="10" Width="38" Height="38"><TextBlock Text="m" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0"/></Border>
          <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="Mevo Companion" Foreground="White" FontSize="15" FontWeight="SemiBold"/>
            <TextBlock Text="Mevo+ · GSPro · Springbok" Foreground="#8CB29F" FontSize="11" Margin="0,1,0,0"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1">
          <Button x:Name="NavPlay" Style="{StaticResource Navigation}" Click="Nav_Click" Tag="play" AutomationProperties.Name="Play">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Icon}" Text="&#xE768;"/><TextBlock Grid.Column="1" Text="Play"/></Grid>
          </Button>
          <Button x:Name="NavSetup" Style="{StaticResource Navigation}" Click="Nav_Click" Tag="setup" AutomationProperties.Name="Setup">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Icon}" Text="&#xE9D5;"/><TextBlock Grid.Column="1" Text="Setup"/>
              <Border x:Name="SetupBadge" Grid.Column="2" Background="#E1C27C" CornerRadius="9" Padding="7,1" Visibility="Collapsed"><TextBlock x:Name="SetupBadgeText" Text="0/4" Foreground="#3B2A07" FontSize="11" FontWeight="SemiBold"/></Border>
            </Grid>
          </Button>
          <Button x:Name="NavConnections" Style="{StaticResource Navigation}" Click="Nav_Click" Tag="connections" AutomationProperties.Name="Settings">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Icon}" Text="&#xE713;"/><TextBlock Grid.Column="1" Text="Settings"/>
              <Ellipse x:Name="UnsavedDot" Grid.Column="2" Style="{StaticResource Dot}" Fill="#E1C27C" Visibility="Collapsed" ToolTip="Unsaved changes"/>
            </Grid>
          </Button>
          <Button x:Name="NavHelp" Style="{StaticResource Navigation}" Click="Nav_Click" Tag="help" AutomationProperties.Name="Help">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Icon}" Text="&#xE897;"/><TextBlock Grid.Column="1" Text="Help"/></Grid>
          </Button>
        </StackPanel>

        <!-- Always-visible connection summary, so problems are noticed from any page. -->
        <Border Grid.Row="3" Background="#173A31" CornerRadius="10" Padding="14,12">
          <StackPanel>
            <TextBlock x:Name="SidebarState" Text="NOT CONNECTED" Foreground="#8CB29F" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <DockPanel Margin="0,3"><Ellipse x:Name="SideMevoDot" Style="{StaticResource Dot}" Fill="#5C7A6C" Margin="0,0,9,0"/><TextBlock Text="Mevo+ (FS Golf)" Foreground="#D5E3DA" FontSize="12"/></DockPanel>
            <DockPanel Margin="0,3"><Ellipse x:Name="SideGSProDot" Style="{StaticResource Dot}" Fill="#5C7A6C" Margin="0,0,9,0"/><TextBlock Text="GSPro" Foreground="#D5E3DA" FontSize="12"/></DockPanel>
            <DockPanel Margin="0,3"><Ellipse x:Name="SidePuttingDot" Style="{StaticResource Dot}" Fill="#5C7A6C" Margin="0,0,9,0"/><TextBlock Text="Webcam putting" Foreground="#D5E3DA" FontSize="12"/></DockPanel>
            <TextBlock x:Name="DemoLabel" Text="PREVIEW · No hardware connected" Foreground="#E1C27C" FontSize="10" FontWeight="SemiBold" Margin="0,10,0,0" Visibility="Collapsed"/>
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ============ Main area ============ -->
    <Grid Grid.Column="1" Margin="32,24,32,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

      <DockPanel Margin="0,0,0,18">
        <Border x:Name="StatusPillBorder" DockPanel.Dock="Right" Background="{StaticResource IdleSoft}" CornerRadius="16" Padding="12,6" VerticalAlignment="Top">
          <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusPillDot" Style="{StaticResource Dot}" Fill="{StaticResource Idle}" Margin="0,0,8,0"/><TextBlock x:Name="StatusPill" Text="Waiting for GSPro" FontSize="12" FontWeight="SemiBold"/></StackPanel>
        </Border>
        <StackPanel Margin="0,0,16,0">
          <TextBlock x:Name="PageTitle" Text="Play" FontSize="26" FontWeight="SemiBold"/>
          <TextBlock x:Name="PageSubtitle" Text="Live status of your simulator." Style="{StaticResource Body}" Margin="0,2,0,0"/>
        </StackPanel>
      </DockPanel>

      <Border x:Name="AlertBar" Grid.Row="1" Background="{StaticResource WarnSoft}" CornerRadius="9" Padding="14,8,6,8" Margin="0,0,0,14" Visibility="Collapsed">
        <DockPanel>
          <TextBlock x:Name="AlertIcon" Style="{StaticResource Icon}" Text="&#xE7BA;" Foreground="{StaticResource Warn}" Margin="0,0,11,0"/>
          <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="Dismiss_Click" ToolTip="Dismiss" AutomationProperties.Name="Dismiss" Foreground="{StaticResource Muted}"><TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12"/></Button>
          <TextBlock x:Name="AlertText" FontSize="13" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <ScrollViewer x:Name="PageScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,4">
        <Grid>

          <!-- ============ Play ============ -->
          <StackPanel x:Name="PlayPage">
            <Border Style="{StaticResource Card}" Padding="0" Margin="0,0,0,16">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
                <Border x:Name="BannerStripe" Background="{StaticResource Idle}" CornerRadius="12,0,0,12"/>
                <StackPanel Grid.Column="1" Margin="22,20,16,20">
                  <TextBlock x:Name="BannerTitle" Text="Waiting for GSPro" FontSize="22" FontWeight="SemiBold"/>
                  <TextBlock x:Name="BannerBody" Text="Open GSPro and the companion connects your Mevo+ and webcam automatically." Style="{StaticResource Body}" Margin="0,6,0,16"/>
                  <WrapPanel>
                    <Button x:Name="PlayButton" Style="{StaticResource Primary}" Click="Play_Click" Margin="0,0,8,0">
                      <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE768;" FontSize="12" Margin="0,0,8,0"/><TextBlock x:Name="PlayButtonText" Text="Start GSPro"/></StackPanel>
                    </Button>
                    <Button x:Name="PauseButton" Click="Pause_Click" Margin="0,0,8,0">
                      <StackPanel Orientation="Horizontal"><TextBlock x:Name="PauseIcon" Style="{StaticResource Icon}" Text="&#xE769;" FontSize="12" Margin="0,0,8,0"/><TextBlock x:Name="PauseText" Text="Pause shots"/></StackPanel>
                    </Button>
                    <Button Click="ShowPutting_Click" ToolTip="Show the Springbok camera view to check the ball position">
                      <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE8B8;" FontSize="13" Margin="0,0,8,0"/><TextBlock Text="Putting camera"/></StackPanel>
                    </Button>
                  </WrapPanel>
                </StackPanel>
                <Border Grid.Column="2" Background="#F3F7F2" CornerRadius="0,12,12,0" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                  <StackPanel VerticalAlignment="Center" Margin="20,16">
                    <TextBlock Text="ACTIVE CLUB" Style="{StaticResource Eyebrow}"/>
                    <TextBlock x:Name="ClubText" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,2,0,0" TextWrapping="NoWrap"/>
                    <TextBlock x:Name="ModeText" Text="Select a club in GSPro" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                    <TextBlock x:Name="DistanceText" Style="{StaticResource Hint}" Margin="0,3,0,0" Visibility="Collapsed"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <UniformGrid Columns="3" Margin="0,0,0,16">
              <Border Style="{StaticResource Card}" Margin="0,0,6,0" Padding="18,16">
                <DockPanel>
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE701;" Foreground="{StaticResource Muted}" Margin="0,0,9,0"/>
                    <Border x:Name="MevoChip" DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{StaticResource IdleSoft}"><TextBlock x:Name="MevoState" Text="Waiting" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/></Border>
                    <TextBlock Text="Mevo+" Style="{StaticResource Subheading}" Margin="0"/>
                  </DockPanel>
                  <Button x:Name="MevoAction" DockPanel.Dock="Bottom" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="-8,6,0,-6" Content="Open FS Golf" Click="OpenFS_Click" Visibility="Collapsed"/>
                  <TextBlock x:Name="MevoMessage" Text="FS Golf connects automatically." Style="{StaticResource Hint}" MinHeight="36"/>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="6,0,6,0" Padding="18,16">
                <DockPanel>
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7FC;" Foreground="{StaticResource Muted}" Margin="0,0,9,0"/>
                    <Border x:Name="GSProChip" DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{StaticResource IdleSoft}"><TextBlock x:Name="GSProState" Text="Waiting" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/></Border>
                    <TextBlock Text="GSPro" Style="{StaticResource Subheading}" Margin="0"/>
                  </DockPanel>
                  <Button x:Name="GSProAction" DockPanel.Dock="Bottom" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="-8,6,0,-6" Content="Start GSPro" Click="Play_Click" Visibility="Collapsed"/>
                  <TextBlock x:Name="GSProMessage" Text="Open GSPro to connect." Style="{StaticResource Hint}" MinHeight="36"/>
                </DockPanel>
              </Border>
              <Border Style="{StaticResource Card}" Margin="6,0,0,0" Padding="18,16">
                <DockPanel>
                  <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8B8;" Foreground="{StaticResource Muted}" Margin="0,0,9,0"/>
                    <Border x:Name="PuttingChip" DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{StaticResource IdleSoft}"><TextBlock x:Name="PuttingState" Text="Waiting" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/></Border>
                    <TextBlock Text="Webcam putting" Style="{StaticResource Subheading}" Margin="0"/>
                  </DockPanel>
                  <Button x:Name="PuttingAction" DockPanel.Dock="Bottom" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="-8,6,0,-6" Content="Show camera view" Click="ShowPutting_Click" Visibility="Collapsed"/>
                  <TextBlock x:Name="PuttingMessage" Text="Select the putter in GSPro to use your webcam." Style="{StaticResource Hint}" MinHeight="36"/>
                </DockPanel>
              </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,0,0,16">
              <StackPanel>
                <DockPanel Margin="0,0,0,12">
                  <Border x:Name="LastShotChip" DockPanel.Dock="Right" Style="{StaticResource Chip}" Background="{StaticResource IdleSoft}" Visibility="Collapsed"><TextBlock x:Name="LastShotStatus" FontSize="11" FontWeight="SemiBold"/></Border>
                  <TextBlock Text="Last shot" Style="{StaticResource Subheading}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                  <TextBlock x:Name="LastShotMeta" Style="{StaticResource Hint}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="EmptyShots" Text="Hit a shot and its numbers appear here, along with whether GSPro accepted it. Select the putter in GSPro to switch to webcam putting." Style="{StaticResource Body}"/>
                <StackPanel x:Name="LastShotPanel" Visibility="Collapsed">
                  <UniformGrid Columns="6">
                    <StackPanel><TextBlock Text="Ball speed · mph" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="LastSpeed" Text="—" Style="{StaticResource MetricValue}"/></StackPanel>
                    <StackPanel><TextBlock Text="Direction · °" Style="{StaticResource MetricLabel}" ToolTip="Horizontal launch angle"/><TextBlock x:Name="LastHla" Text="—" Style="{StaticResource MetricValue}"/></StackPanel>
                    <StackPanel><TextBlock Text="Launch · °" Style="{StaticResource MetricLabel}" ToolTip="Vertical launch angle"/><TextBlock x:Name="LastVla" Text="—" Style="{StaticResource MetricValue}"/></StackPanel>
                    <StackPanel><TextBlock Text="Spin · rpm" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="LastSpin" Text="—" Style="{StaticResource MetricValue}"/></StackPanel>
                    <StackPanel><TextBlock Text="Spin axis · °" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="LastAxis" Text="—" Style="{StaticResource MetricValue}"/></StackPanel>
                    <StackPanel><TextBlock Text="Club speed · mph" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="LastClub" Text="—" Style="{StaticResource MetricValue}"/></StackPanel>
                  </UniformGrid>
                  <TextBlock x:Name="LastShotMessage" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <StackPanel x:Name="HistorySection" Visibility="Collapsed">
              <TextBlock Text="Session history" Style="{StaticResource Subheading}" Margin="2,0,0,8"/>
              <Border Style="{StaticResource Card}" Padding="18,10">
                <StackPanel>
                  <Grid Margin="0,4,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="TIME" Style="{StaticResource Eyebrow}"/><TextBlock Grid.Column="1" Text="SOURCE" Style="{StaticResource Eyebrow}"/><TextBlock Grid.Column="2" Text="BALL SPEED" Style="{StaticResource Eyebrow}"/><TextBlock Grid.Column="3" Text="DIRECTION" Style="{StaticResource Eyebrow}"/><TextBlock Grid.Column="4" Text="GSPRO" Style="{StaticResource Eyebrow}"/>
                  </Grid>
                  <ItemsControl x:Name="ShotList">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,8">
                        <Grid>
                          <Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Time}" Foreground="{StaticResource Subtle}" FontSize="12" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="1" Text="{Binding Source}" FontSize="12" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="2" Text="{Binding Speed}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="3" Text="{Binding Direction}" FontSize="12" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="4" Orientation="Horizontal" ToolTip="{Binding Message}">
                            <Border Style="{StaticResource Chip}" Background="{Binding Soft}"><TextBlock Text="{Binding Status}" Foreground="{Binding Strong}" FontSize="11" FontWeight="SemiBold"/></Border>
                            <TextBlock Text="{Binding Message}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="360"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>

          <!-- ============ Setup ============ -->
          <StackPanel x:Name="SetupPage" Visibility="Collapsed">
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Button Style="{StaticResource StepButton}" Tag="0" Click="Step_Click">
                <StackPanel Orientation="Horizontal"><Border x:Name="StepCircle1" Width="28" Height="28" CornerRadius="14" BorderThickness="2"><TextBlock x:Name="StepNum1" Text="1" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/></Border>
                  <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="Step1" Text="Equipment" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="StepState1" Text="To do" FontSize="11"/></StackPanel></StackPanel>
              </Button>
              <Button Grid.Column="1" Style="{StaticResource StepButton}" Tag="1" Click="Step_Click">
                <StackPanel Orientation="Horizontal"><Border x:Name="StepCircle2" Width="28" Height="28" CornerRadius="14" BorderThickness="2"><TextBlock x:Name="StepNum2" Text="2" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/></Border>
                  <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="Step2" Text="Shot reading" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="StepState2" Text="To do" FontSize="11"/></StackPanel></StackPanel>
              </Button>
              <Button Grid.Column="2" Style="{StaticResource StepButton}" Tag="2" Click="Step_Click">
                <StackPanel Orientation="Horizontal"><Border x:Name="StepCircle3" Width="28" Height="28" CornerRadius="14" BorderThickness="2"><TextBlock x:Name="StepNum3" Text="3" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/></Border>
                  <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="Step3" Text="Putting" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="StepState3" Text="To do" FontSize="11"/></StackPanel></StackPanel>
              </Button>
              <Button Grid.Column="3" Style="{StaticResource StepButton}" Tag="3" Click="Step_Click">
                <StackPanel Orientation="Horizontal"><Border x:Name="StepCircle4" Width="28" Height="28" CornerRadius="14" BorderThickness="2"><TextBlock x:Name="StepNum4" Text="4" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center"/></Border>
                  <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="Step4" Text="Practice" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="StepState4" Text="To do" FontSize="11"/></StackPanel></StackPanel>
              </Button>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="26,24">
              <Grid>
                <!-- Step 1: equipment -->
                <StackPanel x:Name="EquipmentStep">
                  <TextBlock Text="Find your equipment" Style="{StaticResource Heading}"/>
                  <TextBlock Text="Turn on your Mevo+ and connect it in FS Golf. The companion looks for GSPro and FS Golf on this PC; choose them yourself if they weren't found." Style="{StaticResource Body}"/>
                  <Border Style="{StaticResource Inset}" Margin="0,18,0,8" Padding="16,12">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock x:Name="FoundGSProIcon" Style="{StaticResource Icon}" Text="&#xEA3A;" Foreground="{StaticResource Idle}" FontSize="18"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="GSPro" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="FoundGSPro" Text="Looking for your installation…" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
                      <Button Grid.Column="2" Content="Browse…" Tag="gspro" Click="BrowseSetup_Click" Margin="12,0,0,0"/>
                    </Grid>
                  </Border>
                  <Border Style="{StaticResource Inset}" Padding="16,12">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock x:Name="FoundFSGolfIcon" Style="{StaticResource Icon}" Text="&#xEA3A;" Foreground="{StaticResource Idle}" FontSize="18"/>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="FS Golf PC" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="FoundFSGolf" Text="Looking for your installation…" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
                      <Button Grid.Column="2" Content="Browse…" Tag="fsgolf" Click="BrowseSetup_Click" Margin="12,0,0,0"/>
                    </Grid>
                  </Border>
                  <Button Content="Search again" Style="{StaticResource Ghost}" Click="Discover_Click" HorizontalAlignment="Left" Margin="-8,10,0,0"/>
                  <TextBlock Text="GSPro connects through Open Connect. FS Golf stays your Mevo+ shot source, and Springbok's tracker reads your putts from the webcam." Style="{StaticResource Hint}" Margin="0,14,0,0"/>
                </StackPanel>

                <!-- Step 2: FS Golf shot reading -->
                <StackPanel x:Name="ReadingStep" Visibility="Collapsed">
                  <TextBlock Text="Check shot reading" Style="{StaticResource Heading}"/>
                  <TextBlock Text="The companion reads each shot from FS Golf's Play Mode. No screen regions to draw." Style="{StaticResource Body}"/>
                  <Grid Margin="0,16,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0"><TextBlock Text="1" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent}"/><TextBlock Text="Open FS Golf and enter Play Mode." Style="{StaticResource Body}"/></StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="2" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent}"/><TextBlock Text="Select Check shot reading below." Style="{StaticResource Body}"/></StackPanel>
                    <StackPanel Grid.Column="2"><TextBlock Text="3" Style="{StaticResource Eyebrow}" Foreground="{StaticResource Accent}"/><TextBlock Text="Hit a shot. Its numbers appear here; nothing is sent to GSPro." Style="{StaticResource Body}"/></StackPanel>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Button Content="Open FS Golf" Click="OpenFS_Click"/>
                    <Button x:Name="CheckReadingButton" Content="Check shot reading" Click="CheckReading_Click" Style="{StaticResource Primary}" Margin="8,0,0,0"/>
                  </StackPanel>
                  <Border Background="#EEF3ED" CornerRadius="10" MinHeight="180" MaxHeight="290">
                    <Grid>
                      <TextBlock x:Name="PreviewPlaceholder" Text="Live measurements will appear here." HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Style="{StaticResource Hint}"/>
                      <Image x:Name="ShotPreview" Stretch="Uniform"/>
                      <UniformGrid x:Name="NativeMetricsGrid" Visibility="Collapsed" Columns="3" Margin="18,12">
                        <StackPanel Margin="6,8"><TextBlock Text="Ball speed · mph" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="LiveBall" Text="—" Style="{StaticResource MetricValue}"/></StackPanel>
                        <StackPanel Margin="6,8"><TextBlock Text="Direction · °" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="LiveHla" Text="—" Style="{StaticResource MetricValue}"/></StackPanel>
                        <StackPanel Margin="6,8"><TextBlock Text="Launch · °" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="LiveVla" Text="—" Style="{StaticResource MetricValue}"/></StackPanel>
                        <StackPanel Margin="6,8"><TextBlock Text="Spin · rpm" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="LiveSpin" Text="—" Style="{StaticResource MetricValue}"/></StackPanel>
                        <StackPanel Margin="6,8"><TextBlock Text="Spin axis · °" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="LiveAxis" Text="—" Style="{StaticResource MetricValue}"/></StackPanel>
                        <StackPanel Margin="6,8"><TextBlock Text="Club speed · mph" Style="{StaticResource MetricLabel}"/><TextBlock x:Name="LiveClub" Text="—" Style="{StaticResource MetricValue}"/></StackPanel>
                      </UniformGrid>
                    </Grid>
                  </Border>
                  <DockPanel Margin="0,12,0,0">
                    <TextBlock x:Name="ReadingIcon" Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource Idle}" Margin="0,0,9,0" VerticalAlignment="Top" FontSize="14" Padding="0,2,0,0"/>
                    <TextBlock x:Name="ReadingMessage" Text="Select Check shot reading to start." Style="{StaticResource Body}"/>
                  </DockPanel>
                  <TextBlock x:Name="ReadingValues" FontSize="12" FontWeight="SemiBold" Margin="23,6,0,0"/>
                </StackPanel>

                <!-- Step 3: Springbok putting -->
                <StackPanel x:Name="PuttingStep" Visibility="Collapsed">
                  <TextBlock Text="Set up webcam putting" Style="{StaticResource Heading}"/>
                  <TextBlock Text="Putting uses Springbok's original ball tracker. Choose the camera pointed at your putting mat, then open the camera view to position the ball." Style="{StaticResource Body}"/>
                  <TextBlock Text="Putting camera" Style="{StaticResource Label}" Margin="0,18,0,6"/>
                  <DockPanel><Button DockPanel.Dock="Right" Click="Cameras_Click" Margin="8,0,0,0" ToolTip="Look for cameras again"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,7,0"/><TextBlock Text="Refresh"/></StackPanel></Button><ComboBox x:Name="SetupCamera" DisplayMemberPath="Name" SelectedValuePath="Index"/></DockPanel>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="Ball color" Style="{StaticResource Label}"/><ComboBox x:Name="SetupColor"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Camera resolution" Style="{StaticResource Label}"/><ComboBox x:Name="SetupWidth" DisplayMemberPath="Label" SelectedValuePath="Value"/></StackPanel>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="Open camera view" Click="SetupPutting_Click" Style="{StaticResource Primary}"/>
                    <Button Content="Tracker settings" Click="PuttingSettings_Click" Margin="8,0,0,0" ToolTip="Opens Springbok's advanced detection settings. Setup validation is reset."/>
                  </StackPanel>
                  <Border Style="{StaticResource Inset}" Margin="0,18,0,0" Padding="14,12">
                    <StackPanel>
                      <TextBlock Text="In the Springbok camera view" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                      <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,4"><Border Background="White" BorderBrush="{StaticResource Field}" BorderThickness="1" CornerRadius="4" Padding="7,1"><TextBlock Text="A" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock Text="Advanced settings" Style="{StaticResource Hint}" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,4"><Border Background="White" BorderBrush="{StaticResource Field}" BorderThickness="1" CornerRadius="4" Padding="7,1"><TextBlock Text="D" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock Text="Tune ball detection" Style="{StaticResource Hint}" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,4"><Border Background="White" BorderBrush="{StaticResource Field}" BorderThickness="1" CornerRadius="4" Padding="7,1"><TextBlock Text="Q" FontSize="11" FontWeight="SemiBold"/></Border><TextBlock Text="Close the view" Style="{StaticResource Hint}" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
                      </WrapPanel>
                      <TextBlock Text="Roll a practice putt and check the reported speed and direction. Practice putts are never sent to GSPro." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
                    </StackPanel>
                  </Border>
                  <DockPanel Margin="0,14,0,0">
                    <TextBlock x:Name="PuttingPreviewIcon" Style="{StaticResource Icon}" Text="&#xEA3A;" Foreground="{StaticResource Idle}" Margin="0,0,9,0" FontSize="14"/>
                    <TextBlock x:Name="PuttingPreviewStatus" Text="Waiting for a practice putt in the camera view." Style="{StaticResource Body}"/>
                  </DockPanel>
                </StackPanel>

                <!-- Step 4: validate on the GSPro practice range -->
                <StackPanel x:Name="PracticeStep" Visibility="Collapsed">
                  <TextBlock Text="Verify on the practice range" Style="{StaticResource Heading}"/>
                  <TextBlock Text="Open a GSPro practice session and hit one of each shot below. Each one ticks off when GSPro accepts it." Style="{StaticResource Body}"/>
                  <Border Background="{StaticResource WarnSoft}" CornerRadius="9" Padding="14,10" Margin="0,16,0,14">
                    <StackPanel>
                      <CheckBox x:Name="PracticeConsent" Content="I'm in a GSPro practice session. Send my shots to GSPro." FontWeight="SemiBold" Checked="PracticeConsent_Changed" Unchecked="PracticeConsent_Changed"/>
                      <TextBlock Text="Shots are only sent while this is on." Style="{StaticResource Hint}" Margin="21,0,0,2"/>
                    </StackPanel>
                  </Border>
                  <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="9">
                    <StackPanel>
                      <Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="SwingIcon" Style="{StaticResource Icon}" Text="&#xEA3A;" Foreground="{StaticResource Idle}" FontSize="18"/>
                        <StackPanel Grid.Column="1"><TextBlock x:Name="SwingCheck" Text="Full shot" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Any club except the putter, from more than 20 yards out." Style="{StaticResource Hint}"/></StackPanel>
                        <TextBlock x:Name="SwingStatus" Grid.Column="2" Text="Waiting" Style="{StaticResource Hint}" VerticalAlignment="Center"/></Grid>
                      <Border Height="1" Background="{StaticResource Line}"/>
                      <Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ChipIcon" Style="{StaticResource Icon}" Text="&#xEA3A;" Foreground="{StaticResource Idle}" FontSize="18"/>
                        <StackPanel Grid.Column="1"><TextBlock x:Name="ChipCheck" Text="Chip" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="ChipHint" Text="Use GSPro's ball-placement icon (top left) to place the ball off the green within 20 yards of the pin." Style="{StaticResource Hint}"/></StackPanel>
                        <TextBlock x:Name="ChipStatus" Grid.Column="2" Text="Waiting" Style="{StaticResource Hint}" VerticalAlignment="Center"/></Grid>
                      <Border Height="1" Background="{StaticResource Line}"/>
                      <Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="PuttIcon" Style="{StaticResource Icon}" Text="&#xEA3A;" Foreground="{StaticResource Idle}" FontSize="18"/>
                        <StackPanel Grid.Column="1"><TextBlock x:Name="PuttCheck" Text="Webcam putt" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Select the putter in GSPro, then putt on your mat." Style="{StaticResource Hint}"/></StackPanel>
                        <TextBlock x:Name="PuttStatus" Grid.Column="2" Text="Waiting" Style="{StaticResource Hint}" VerticalAlignment="Center"/></Grid>
                    </StackPanel>
                  </Border>
                  <CheckBox x:Name="ChippingCheck" Content="Testing a chip (select Chipping in FS Golf too)" Checked="Chipping_Changed" Unchecked="Chipping_Changed" Margin="0,10,0,0"/>
                  <CheckBox x:Name="ConfirmPractice" Content="All three shots flew correctly in GSPro." Margin="0,18,0,4" Checked="ConfirmPractice_Changed" Unchecked="ConfirmPractice_Changed"/>
                  <CheckBox x:Name="FinishStartup" IsChecked="True" Content="Start with Windows and connect automatically when GSPro opens"/>
                  <TextBlock Text="The companion waits in the system tray. After setup, just turn on your equipment and open GSPro." Style="{StaticResource Hint}" Margin="21,0,0,0"/>
                  <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <Button x:Name="FinishButton" Content="Finish setup" Style="{StaticResource Primary}" Click="Finish_Click" IsEnabled="False"/>
                    <TextBlock x:Name="PracticeResult" Style="{StaticResource Hint}" Margin="14,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </StackPanel>
              </Grid>
            </Border>
          </StackPanel>

          <!-- ============ Settings ============ -->
          <StackPanel x:Name="ConnectionsPage" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <DockPanel><Button DockPanel.Dock="Right" Content="Find installed apps" Style="{StaticResource Ghost}" Click="Discover_Click"/><TextBlock Text="Golf applications" Style="{StaticResource Subheading}" VerticalAlignment="Center"/></DockPanel>
                <TextBlock Text="GSPro application" Style="{StaticResource Label}"/>
                <DockPanel><Button Content="Browse…" DockPanel.Dock="Right" Tag="gspro" Click="BrowseApp_Click" Margin="8,0,0,0"/><TextBox x:Name="GSProPath" TextChanged="Setting_Changed"/></DockPanel>
                <TextBlock Text="FS Golf application" Style="{StaticResource Label}"/>
                <DockPanel><Button Content="Browse…" DockPanel.Dock="Right" Tag="fsgolf" Click="BrowseApp_Click" Margin="8,0,0,0"/><TextBox x:Name="FSGolfPath" TextChanged="Setting_Changed"/></DockPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Automation" Style="{StaticResource Subheading}" Margin="0,0,0,8"/>
                <CheckBox x:Name="AutoConnect" Content="Connect automatically when GSPro opens" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                <CheckBox x:Name="WindowsStartup" Content="Start Mevo Companion in the tray when I sign in to Windows" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                <CheckBox x:Name="AutoChipping" Content="Switch FS Golf to Chipping within 20 yards of the pin" Checked="Setting_Changed" Unchecked="Setting_Changed" Margin="0,6,0,0"/>
                <TextBlock Text="Turn off to choose Full Swing or Chipping in FS Golf yourself. The putter always uses the webcam." Style="{StaticResource Hint}" Margin="21,0,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Webcam putting" Style="{StaticResource Subheading}"/>
                <TextBlock Text="Putting camera" Style="{StaticResource Label}"/>
                <DockPanel><Button DockPanel.Dock="Right" Click="Cameras_Click" Margin="8,0,0,0" ToolTip="Look for cameras again"><StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12" Margin="0,0,7,0"/><TextBlock Text="Refresh"/></StackPanel></Button><ComboBox x:Name="SettingsCamera" DisplayMemberPath="Name" SelectedValuePath="Index" SelectionChanged="Setting_Changed"/></DockPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,10,0"><TextBlock Text="Ball color" Style="{StaticResource Label}"/><ComboBox x:Name="SettingsColor" SelectionChanged="Setting_Changed"/></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="Camera resolution" Style="{StaticResource Label}"/><ComboBox x:Name="SettingsWidth" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="Setting_Changed"/></StackPanel>
                </Grid>
                <DockPanel Margin="0,12,0,0"><TextBlock Style="{StaticResource Icon}" Text="&#xE946;" Foreground="{StaticResource Subtle}" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Top" Padding="0,2,0,0"/><TextBlock Text="Changing the camera, ball color or resolution means re-checking putting and the practice shots in Setup." Style="{StaticResource Hint}"/></DockPanel>
                <Button Content="Springbok tracker settings" Click="PuttingSettings_Click" HorizontalAlignment="Left" Margin="0,14,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <Expander Header="Advanced" FontWeight="SemiBold" FontSize="14">
                <StackPanel Margin="0,8,0,0" TextElement.FontWeight="Normal" TextElement.FontSize="13">
                  <TextBlock Text="Shot source" Style="{StaticResource Label}"/>
                  <ComboBox x:Name="AdapterChoice" SelectionChanged="Setting_Changed"><ComboBoxItem Content="FS Golf automatic reading (recommended)" Tag="ocr"/><ComboBoxItem Content="Direct Mevo+ (experimental · not in this build)" Tag="direct" IsEnabled="False"/></ComboBox>
                  <TextBlock Text="FS Golf speed units" Style="{StaticResource Label}"/>
                  <ComboBox x:Name="SpeedUnits" SelectionChanged="Setting_Changed"><ComboBoxItem Content="Detect automatically" Tag="auto"/><ComboBoxItem Content="Miles per hour (mph)" Tag="mph"/><ComboBoxItem Content="Kilometres per hour (km/h)" Tag="km/h"/><ComboBoxItem Content="Metres per second (m/s)" Tag="m/s"/></ComboBox>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0"><TextBlock Text="GSPro Open Connect address" Style="{StaticResource Label}"/><TextBox x:Name="GSProHost" TextChanged="Setting_Changed"/></StackPanel>
                    <StackPanel Grid.Column="1"><TextBlock Text="Port" Style="{StaticResource Label}"/><TextBox x:Name="GSProPort" TextChanged="Setting_Changed"/></StackPanel>
                  </Grid>
                  <TextBlock Text="Direct Mevo+ address (experimental only)" Style="{StaticResource Label}"/>
                  <TextBox x:Name="MevoAddress" TextChanged="Setting_Changed"/>
                  <Button Content="Import a Springbok profile…" Click="Import_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/>
                  <TextBlock Text="Imports config.ini or a device profile into a separate copy. Your original Springbok files are never changed." Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                </StackPanel>
              </Expander>
            </Border>
          </StackPanel>

          <!-- ============ Help ============ -->
          <StackPanel x:Name="HelpPage" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Something not working?" Style="{StaticResource Subheading}"/>
                <TextBlock x:Name="TroubleSummary" Text="Everything looks fine right now." Style="{StaticResource Body}"/>
                <WrapPanel Margin="0,14,0,0">
                  <Button Content="Reconnect equipment" Click="Reconnect_Click" Style="{StaticResource Primary}" Margin="0,0,8,0"/>
                  <Button Content="Export diagnostics…" Click="Diagnostics_Click" Margin="0,0,8,0"/>
                  <Button Content="Open data folder" Click="OpenData_Click"/>
                </WrapPanel>
                <TextBlock Text="Diagnostics include your connection settings and recent events. Nothing is uploaded; share the file only with someone helping you." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
              <StackPanel>
                <TextBlock Text="Good to know" Style="{StaticResource Subheading}" Margin="0,0,0,8"/>
                <TextBlock Style="{StaticResource Body}" Text="• Keep FS Golf on its live shot view in Play Mode. Don't browse shot history during a round.&#10;• If FS Golf is minimized, restore it so its shot data can be read.&#10;• Selecting the putter in GSPro switches to webcam putting.&#10;• After reconnecting mid-round, reselect your club once in GSPro.&#10;• Old readings are held after a reconnect, so a previous shot is never replayed."/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Padding="18,14">
              <StackPanel>
                <DockPanel Margin="0,0,0,6"><Button DockPanel.Dock="Right" Content="Copy" Style="{StaticResource Ghost}" Click="CopyLog_Click" ToolTip="Copy the activity log to the clipboard"/><TextBlock Text="Activity" Style="{StaticResource Subheading}" VerticalAlignment="Center" Margin="0"/></DockPanel>
                <ListBox x:Name="EventList" BorderThickness="0" Background="Transparent" FontSize="12" Foreground="{StaticResource Muted}" MaxHeight="240" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="2,5"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource Muted}"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>
            <TextBlock x:Name="EngineStatus" Text="Starting connection engine…" Style="{StaticResource Hint}" Margin="2,12,0,0"/>
            <TextBlock Text="Mevo Companion 0.1 · Built on the Springbok connector (GPL-3.0). Not affiliated with FlightScope or GSPro." Style="{StaticResource Hint}" Margin="2,4,0,0"/>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!-- Footer row: setup wizard navigation or the settings save bar. -->
      <DockPanel x:Name="WizardNavigation" Grid.Row="3" Margin="0,14,8,0" Visibility="Collapsed">
        <Button x:Name="NextStep" DockPanel.Dock="Right" Content="Continue" Style="{StaticResource Primary}" Click="Next_Click" MinWidth="120"/>
        <Button x:Name="PreviousStep" Content="Back" HorizontalAlignment="Left" Click="Back_Click" MinWidth="90"/>
        <TextBlock x:Name="StepCount" Text="Step 1 of 4" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource Hint}"/>
      </DockPanel>
      <Border x:Name="SaveBar" Grid.Row="3" Margin="0,14,8,0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16,8" Visibility="Collapsed">
        <DockPanel>
          <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="Save changes" Style="{StaticResource Primary}" Click="Save_Click" IsEnabled="False"/>
          <Button x:Name="DiscardButton" DockPanel.Dock="Right" Content="Discard" Style="{StaticResource Ghost}" Click="Discard_Click" Margin="0,0,8,0" IsEnabled="False"/>
          <TextBlock x:Name="SaveState" Text="All changes saved." Style="{StaticResource Hint}" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
