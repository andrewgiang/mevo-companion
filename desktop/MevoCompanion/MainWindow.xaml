<Window x:Class="MevoCompanion.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mevo Companion" Width="1180" Height="830" MinWidth="1000" MinHeight="720"
        FontFamily="Segoe UI" Background="#F5F8F4" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid Background="#F5F8F4">
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#102D27">
      <Grid Margin="18,30,18,20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="16,0,10,32">
          <Border Background="#D4EBCF" CornerRadius="12" Width="44" Height="44" HorizontalAlignment="Left" Margin="0,0,0,18"><TextBlock Text="m" FontSize="31" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0"/></Border>
          <TextBlock Text="MEVO" Foreground="White" FontSize="20" FontWeight="Bold"/>
          <TextBlock Text="COMPANION" Foreground="#90B8A4" FontSize="11" Margin="1,3,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1">
          <Button x:Name="NavPlay" Content="Play" Style="{StaticResource Navigation}" Click="Nav_Click" Tag="play"/>
          <Button x:Name="NavSetup" Content="Setup" Style="{StaticResource Navigation}" Click="Nav_Click" Tag="setup"/>
          <Button x:Name="NavConnections" Content="Connections" Style="{StaticResource Navigation}" Click="Nav_Click" Tag="connections"/>
          <Button x:Name="NavHelp" Content="Help &amp; diagnostics" Style="{StaticResource Navigation}" Click="Nav_Click" Tag="help"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="14,0,8,0">
          <TextBlock x:Name="SidebarState" Text="YOUR SIMULATOR, TOGETHER" Foreground="#8CB29F" FontSize="10" FontWeight="SemiBold"/>
          <TextBlock Text="Mevo+ · GSPro · Springbok" Foreground="#A8C3B5" FontSize="11" Margin="0,8,0,0"/>
          <TextBlock x:Name="DemoLabel" Text="PREVIEW · No hardware connected" Foreground="#E1C27C" FontSize="10" Margin="0,12,0,0" Visibility="Collapsed"/>
        </StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1" Margin="34,25,34,22">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,22">
        <Border DockPanel.Dock="Right" Background="#E5ECE5" CornerRadius="16" Padding="13,7"><TextBlock x:Name="StatusPill" Text="Waiting for GSPro" FontSize="11" FontWeight="SemiBold"/></Border>
        <StackPanel><TextBlock x:Name="PageEyebrow" Text="YOUR SIMULATOR" FontSize="10" Foreground="#7C8D82" FontWeight="SemiBold"/><TextBlock x:Name="PageTitle" Text="Let’s play." FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel>
      </DockPanel>
      <Border x:Name="AlertBar" Grid.Row="1" Background="#FFF0D8" CornerRadius="9" Padding="14,11" Margin="0,0,0,16" Visibility="Collapsed"><DockPanel><Button DockPanel.Dock="Right" Content="Dismiss" Padding="8,2" MinHeight="24" Click="Dismiss_Click" Margin="12,0,0,0"/><TextBlock x:Name="AlertText" Foreground="#75541D" FontSize="12" VerticalAlignment="Center"/></DockPanel></Border>
      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,5">
        <Grid>
          <StackPanel x:Name="PlayPage">
            <Border Background="#E5EEDF" CornerRadius="17" Padding="28" Margin="0,0,0,20">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock x:Name="HeroTitle" Text="Open GSPro.&#10;Everything follows." FontSize="30" FontWeight="SemiBold" LineHeight="37"/><TextBlock x:Name="HeroBody" Text="Your Mevo+ for the approach. Your webcam for the green.&#10;One companion takes care of the connection." Style="{StaticResource Body}" Margin="0,13,15,22"/>
                  <StackPanel Orientation="Horizontal"><Button x:Name="PlayButton" Content="Start GSPro" Style="{StaticResource Primary}" Click="Play_Click"/><Button x:Name="PauseButton" Content="Pause shots" Click="Pause_Click" Margin="10,0,0,0"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"><Border Width="100" Height="100" CornerRadius="50" BorderBrush="#C1D5BC" BorderThickness="1"><Border Margin="12" CornerRadius="40" Background="#D6E5CE"><TextBlock Text="↗" FontSize="48" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#3E7257"/></Border></Border><TextBlock x:Name="ActiveClub" Text="Ready when you are" FontSize="11" Foreground="#53735F" Margin="0,13,0,0"/></StackPanel>
              </Grid>
            </Border>
            <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Card}" Margin="0,0,7,0"><StackPanel><TextBlock Text="01  /  FULL SHOTS" FontSize="10" Foreground="#839187" FontWeight="SemiBold"/><TextBlock Text="Mevo+" Style="{StaticResource Subheading}" Margin="0,14,0,8"/><TextBlock x:Name="MevoState" Text="Waiting" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="MevoMessage" Text="FS Golf connects automatically." Style="{StaticResource Body}" Margin="0,7,0,0" MinHeight="58"/></StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource Card}" Margin="7,0,7,0"><StackPanel><TextBlock Text="02  /  YOUR ROUND" FontSize="10" Foreground="#839187" FontWeight="SemiBold"/><TextBlock Text="GSPro" Style="{StaticResource Subheading}" Margin="0,14,0,8"/><TextBlock x:Name="GSProState" Text="Waiting" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="GSProMessage" Text="Open GSPro to connect." Style="{StaticResource Body}" Margin="0,7,0,0" MinHeight="58"/></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0,0,0"><StackPanel><TextBlock Text="03  /  ON THE GREEN" FontSize="10" Foreground="#839187" FontWeight="SemiBold"/><TextBlock Text="Webcam putting" Style="{StaticResource Subheading}" Margin="0,14,0,8"/><TextBlock x:Name="PuttingState" Text="Waiting" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="PuttingMessage" Text="Powered by Springbok putting." Style="{StaticResource Body}" Margin="0,7,0,0" MinHeight="58"/></StackPanel></Border>
            </Grid>
            <DockPanel Margin="0,0,0,10"><Button DockPanel.Dock="Right" Content="Putting view" Click="ShowPutting_Click" Padding="12,6" MinHeight="30"/><TextBlock Text="Recent shots" Style="{StaticResource Subheading}" VerticalAlignment="Center"/></DockPanel>
            <Border Style="{StaticResource Card}" Padding="18,12"><StackPanel><TextBlock x:Name="EmptyShots" Text="Your first shot will appear here, with its delivery status." Style="{StaticResource Body}" Margin="0,8"/><ItemsControl x:Name="ShotList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="65"/><ColumnDefinition Width="100"/><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time}" Foreground="#819087" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding Source}" FontSize="12"/><TextBlock Grid.Column="2" Text="{Binding Speed}" FontSize="12" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="{Binding Status}" FontSize="12" Foreground="#63746D"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            <TextBlock Text="Select the putter in GSPro to switch to your webcam automatically." Style="{StaticResource Body}" Margin="2,16,0,0"/>
          </StackPanel>

          <StackPanel x:Name="SetupPage" Visibility="Collapsed">
            <UniformGrid Columns="4" Margin="0,0,0,18"><TextBlock x:Name="Step1" Text="01   Equipment" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="Step2" Text="02   Shot reading" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="Step3" Text="03   Putting" FontSize="12" FontWeight="SemiBold"/><TextBlock x:Name="Step4" Text="04   Practice" FontSize="12" FontWeight="SemiBold"/></UniformGrid>
            <Border Style="{StaticResource Card}" MinHeight="420">
              <Grid>
                <StackPanel x:Name="EquipmentStep"><TextBlock Text="Find your setup." Style="{StaticResource Heading}"/><TextBlock Text="Turn on your Mevo+ and keep it connected to this PC. We’ll find your golf apps and webcam." Style="{StaticResource Body}"/><Border Background="#F3F6F1" CornerRadius="9" Padding="18" Margin="0,22"><StackPanel><TextBlock Text="GSPro" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="FoundGSPro" Text="Looking for your installation…" Style="{StaticResource Body}" Margin="0,5,0,16"/><TextBlock Text="FS Golf PC" FontWeight="SemiBold" FontSize="12"/><TextBlock x:Name="FoundFSGolf" Text="Looking for your installation…" Style="{StaticResource Body}" Margin="0,5,0,0"/></StackPanel></Border><StackPanel Orientation="Horizontal"><Button Content="Find equipment" Click="Discover_Click" Style="{StaticResource Primary}"/><Button Content="Choose app locations" Click="Connections_Click" Margin="10,0,0,0"/></StackPanel><TextBlock Text="Use GSPro’s Open Connect connection. FS Golf remains your Mevo+ shot source, and Springbok handles your webcam putts." Style="{StaticResource Body}" Margin="0,22,0,0"/></StackPanel>
                <StackPanel x:Name="ReadingStep" Visibility="Collapsed"><TextBlock Text="Let FS Golf do the measuring." Style="{StaticResource Heading}"/><TextBlock Text="Use Play Mode in FS Golf. The companion switches to Chipping within 20 yards and reads your shots automatically. You can turn off automatic switching in Connections." Style="{StaticResource Body}"/><StackPanel Orientation="Horizontal" Margin="0,16,0,16"><Button Content="Open FS Golf" Click="OpenFS_Click"/><Button Content="Check shot reading" Click="CheckReading_Click" Style="{StaticResource Primary}" Margin="10,0,0,0"/></StackPanel><Border Background="#EEF3ED" CornerRadius="10" MinHeight="200" MaxHeight="290"><Grid><TextBlock x:Name="PreviewPlaceholder" Text="Live measurements will appear here.&#10;No boxes to draw." HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Style="{StaticResource Body}"/><Image x:Name="ShotPreview" Stretch="Uniform"/><UniformGrid x:Name="NativeMetricsGrid" Visibility="Collapsed" Columns="3" Margin="16"><StackPanel Margin="10,10"><TextBlock Text="Ball speed · mph" FontSize="11" Foreground="#728176"/><TextBlock x:Name="LiveBall" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="10,10"><TextBlock Text="Horizontal launch · °" FontSize="11" Foreground="#728176"/><TextBlock x:Name="LiveHla" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="10,10"><TextBlock Text="Vertical launch · °" FontSize="11" Foreground="#728176"/><TextBlock x:Name="LiveVla" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="10,10"><TextBlock Text="Spin · rpm" FontSize="11" Foreground="#728176"/><TextBlock x:Name="LiveSpin" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="10,10"><TextBlock Text="Spin axis · °" FontSize="11" Foreground="#728176"/><TextBlock x:Name="LiveAxis" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel><StackPanel Margin="10,10"><TextBlock Text="Club speed · mph" FontSize="11" Foreground="#728176"/><TextBlock x:Name="LiveClub" Text="—" FontSize="29" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></UniformGrid></Grid></Border><TextBlock x:Name="ReadingMessage" Text="Waiting to check your shot view." Style="{StaticResource Body}" Margin="0,12,0,0"/><TextBlock x:Name="ReadingValues" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel>
                <StackPanel x:Name="PuttingStep" Visibility="Collapsed"><TextBlock Text="Your familiar putting engine." Style="{StaticResource Heading}"/><TextBlock Text="This uses Springbok’s original ball tracker. Choose your camera, then open its live view to position the ball and check the detection window." Style="{StaticResource Body}"/><TextBlock Text="Putting camera" Style="{StaticResource Label}"/><DockPanel><Button Content="Refresh" DockPanel.Dock="Right" Click="Cameras_Click" Margin="10,0,0,0"/><ComboBox x:Name="SetupCamera" DisplayMemberPath="Name" SelectedValuePath="Index"/></DockPanel><Grid Margin="0,4,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Ball color" Style="{StaticResource Label}"/><ComboBox x:Name="SetupColor"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Preview detail" Style="{StaticResource Label}"/><ComboBox x:Name="SetupWidth" DisplayMemberPath="Label" SelectedValuePath="Value"/></StackPanel></Grid><StackPanel Orientation="Horizontal"><Button Content="Open putting setup" Click="SetupPutting_Click" Style="{StaticResource Primary}"/><Button Content="Tracker settings" Click="PuttingSettings_Click" Margin="10,0,0,0"/></StackPanel><TextBlock Text="In the Springbok window: A opens advanced settings, D tunes ball detection, and Q closes the preview. Roll a practice putt and check the reported speed and direction." Style="{StaticResource Body}" Margin="0,20,0,0"/><TextBlock x:Name="PuttingPreviewStatus" Text="A successful preview putt is required before setup is complete." Style="{StaticResource Body}" Margin="0,12,0,0"/></StackPanel>
                <StackPanel x:Name="PracticeStep" Visibility="Collapsed"><TextBlock Text="Prove it on the practice range." Style="{StaticResource Heading}"/><TextBlock Text="Open a GSPro practice session. Enable delivery below, then hit one full shot, one chip and one webcam putt. For the chip, choose a GSPro target within 20 yards. If automatic Chipping is off, select Chipping in FS Golf Play Mode. Check the flight and direction in GSPro." Style="{StaticResource Body}"/><Border Background="#F5F0E3" CornerRadius="9" Padding="15" Margin="0,17,0,14"><CheckBox x:Name="PracticeConsent" Content="I’m in a GSPro practice session. Enable shot delivery." Checked="PracticeConsent_Changed" Unchecked="PracticeConsent_Changed"/></Border><TextBlock x:Name="SwingCheck" Text="○   Full shot — waiting for GSPro acceptance" Margin="0,8"/><TextBlock x:Name="ChipCheck" Text="○   Chip — waiting for GSPro acceptance" Margin="0,8"/><TextBlock x:Name="PuttCheck" Text="○   Webcam putt — waiting for GSPro acceptance" Margin="0,8"/><CheckBox x:Name="ChippingCheck" Content="Testing a chip (select Chipping in FS Golf too)" Checked="Chipping_Changed" Unchecked="Chipping_Changed"/><CheckBox x:Name="ConfirmPractice" Content="I checked all three shots in GSPro and they look correct." Margin="0,20,0,12"/><Border Background="#F1F5EF" CornerRadius="9" Padding="13" Margin="0,0,0,16"><StackPanel><CheckBox x:Name="FinishStartup" IsChecked="True" Content="Start quietly with Windows and connect when GSPro opens"/><TextBlock Text="The companion stays in your system tray. After this setup, just turn on your equipment and open GSPro." Style="{StaticResource Body}" Margin="20,0,0,0"/></StackPanel></Border><Button Content="Finish setup" Style="{StaticResource Primary}" HorizontalAlignment="Left" Click="Finish_Click"/><TextBlock x:Name="PracticeResult" Style="{StaticResource Body}" Margin="0,12,0,0"/></StackPanel>
              </Grid>
            </Border>
          </StackPanel>

          <StackPanel x:Name="ConnectionsPage" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Margin="0,0,0,17"><StackPanel><TextBlock Text="Golf applications" Style="{StaticResource Subheading}"/><TextBlock Text="Saved once. The companion opens missing apps and reconnects when GSPro starts." Style="{StaticResource Body}"/><TextBlock Text="GSPro application" Style="{StaticResource Label}"/><DockPanel><Button Content="Browse" DockPanel.Dock="Right" Tag="gspro" Click="BrowseApp_Click" Margin="8,0,0,0"/><TextBox x:Name="GSProPath"/></DockPanel><TextBlock Text="FS Golf application" Style="{StaticResource Label}"/><DockPanel><Button Content="Browse" DockPanel.Dock="Right" Tag="fsgolf" Click="BrowseApp_Click" Margin="8,0,0,0"/><TextBox x:Name="FSGolfPath"/></DockPanel><CheckBox x:Name="AutoConnect" Content="Connect automatically when GSPro opens" Margin="0,20,0,4"/><CheckBox x:Name="WindowsStartup" Content="Start Mevo Companion quietly when I sign in to Windows"/><CheckBox x:Name="AutoChipping" Content="Automatically switch to Chipping within 20 yards" Margin="0,16,0,4"/><TextBlock Text="The putter still uses your webcam. Turn off to choose the FS Golf mode yourself." Style="{StaticResource Body}" Margin="20,0,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,17"><StackPanel><TextBlock Text="Springbok webcam putting" Style="{StaticResource Subheading}"/><DockPanel Margin="0,8,0,4"><Button Content="Find cameras" DockPanel.Dock="Right" Click="Cameras_Click" Margin="10,0,0,0"/><ComboBox x:Name="SettingsCamera" DisplayMemberPath="Name" SelectedValuePath="Index"/></DockPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="Ball color" Style="{StaticResource Label}"/><ComboBox x:Name="SettingsColor"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Preview detail" Style="{StaticResource Label}"/><ComboBox x:Name="SettingsWidth" DisplayMemberPath="Label" SelectedValuePath="Value"/></StackPanel></Grid><Button Content="Open Springbok tracker settings" Click="PuttingSettings_Click" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,17"><Expander Header="Advanced connection options" FontWeight="SemiBold"><StackPanel Margin="0,12,0,0"><TextBlock Text="Shot source" Style="{StaticResource Label}"/><ComboBox x:Name="AdapterChoice"><ComboBoxItem Content="FS Golf automatic reading (recommended)" Tag="ocr"/><ComboBoxItem Content="Direct Mevo+ (experimental · unavailable in this build)" Tag="direct" IsEnabled="False"/></ComboBox><TextBlock Text="FS Golf speed units" Style="{StaticResource Label}"/><ComboBox x:Name="SpeedUnits"><ComboBoxItem Content="Detect visible units automatically" Tag="auto"/><ComboBoxItem Content="Miles per hour (mph)" Tag="mph"/><ComboBoxItem Content="Kilometres per hour (km/h)" Tag="km/h"/><ComboBoxItem Content="Metres per second (m/s)" Tag="m/s"/></ComboBox><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><TextBlock Text="GSPro address" Style="{StaticResource Label}"/><TextBox x:Name="GSProHost"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Port" Style="{StaticResource Label}"/><TextBox x:Name="GSProPort"/></StackPanel></Grid><TextBlock Text="Direct Mevo+ address (experimental only)" Style="{StaticResource Label}"/><TextBox x:Name="MevoAddress"/><Button Content="Import an existing connector profile…" Click="Import_Click" HorizontalAlignment="Left" Margin="0,17,0,0"/><TextBlock Text="Automatic reading is the normal setup. An imported OCR profile is an explicit compatibility option." Style="{StaticResource Body}" Margin="0,10,0,0"/></StackPanel></Expander></Border>
            <StackPanel Orientation="Horizontal"><Button Content="Save connections" Style="{StaticResource Primary}" Click="Save_Click"/><Button Content="Find installed apps" Click="Discover_Click" Margin="10,0,0,0"/></StackPanel>
          </StackPanel>

          <StackPanel x:Name="HelpPage" Visibility="Collapsed">
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Get back to your round." Style="{StaticResource Heading}"/><TextBlock Text="Connection problems should tell you what to do next. The cards on Play show the current issue for each part of your setup." Style="{StaticResource Body}"/><StackPanel Orientation="Horizontal" Margin="0,20,0,0"><Button Content="Reconnect equipment" Click="Reconnect_Click" Style="{StaticResource Primary}"/><Button Content="Export diagnostics…" Click="Diagnostics_Click" Margin="10,0,0,0"/></StackPanel><TextBlock Text="Diagnostics contain connection settings and recent events. Share them only with someone you trust to help with your setup." Style="{StaticResource Body}" Margin="0,15,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Good to know" Style="{StaticResource Subheading}"/><TextBlock Text="• Keep FS Golf’s live shot data view open; don’t browse shot history during a round.&#10;• Restoring a minimized FS Golf window may be needed for screen reading.&#10;• The putter selected in GSPro activates Springbok putting.&#10;• Automatic Chipping uses a target distance within 20 yards; turn it off in Connections to choose the FS Golf mode yourself.&#10;• Existing readings are held after reconnect so an old shot isn’t replayed." Style="{StaticResource Body}"/></StackPanel></Border>
            <TextBlock Text="Recent activity" Style="{StaticResource Subheading}"/><Border Style="{StaticResource Card}" Padding="17"><ListBox x:Name="EventList" BorderThickness="0" Background="Transparent" FontSize="12" Foreground="#63746D" MaxHeight="220" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="2,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox></Border><TextBlock x:Name="EngineStatus" Text="Starting connection engine…" Style="{StaticResource Body}" Margin="0,14,0,0"/><TextBlock Text="Mevo Companion 0.1 · Built on the Springbok connector (GPL-3.0). Hardware validation is completed in Setup." FontSize="11" Foreground="#89958D" Margin="0,9,0,0"/>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <DockPanel x:Name="WizardNavigation" Grid.Row="3" Margin="0,15,8,0" Visibility="Collapsed"><Button x:Name="NextStep" DockPanel.Dock="Right" Content="Continue →" Style="{StaticResource Primary}" Click="Next_Click"/><Button x:Name="PreviousStep" Content="← Back" HorizontalAlignment="Left" Click="Back_Click"/><TextBlock x:Name="StepCount" Text="Step 1 of 4" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="#7B8C81"/></DockPanel>
      <DockPanel Grid.Row="4" Margin="0,14,0,0"><TextBlock x:Name="FooterText" Text="Connection checks stay in the background." Foreground="#829087" FontSize="11"/><TextBlock DockPanel.Dock="Right" Text="MEVO COMPANION  /  0.1" Foreground="#9BA79F" FontSize="9" HorizontalAlignment="Right"/></DockPanel>
    </Grid>
  </Grid>
</Window>
